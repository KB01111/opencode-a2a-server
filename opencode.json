{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-fd65bf2a-46df-4d0d-bacc-c64e200e3bd5"
      }
    },
    "fastmcp_server_starter": {
      "type": "local",
      "command": [
        "C:\\Users\\kevin\\AppData\\Local\\hermes\\bin\\uv.exe",
        "run",
        "--directory",
        "C:\\Users\\kevin\\Documents\\Codex\\2026-08-04\\new-chat\\outputs\\fastmcp-server-starter",
        "python",
        "server.py"
      ],
      "enabled": true,
      "environment": {
        "MCP_TRANSPORT": "stdio"
      }
    }
  },
  "disabled_providers": [],
  "provider": {
    "tokenrouter": {
      "name": "TokenRouter",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.tokenrouter.com/v1"
      },
      "models": {
        "moonshotai/kimi-k3-free": {
          "name": "Kimi-K3"
        }
      }
    },
    "merge": {
      "name": "merge.dev",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api-gateway.merge.dev/v1/openai"
      },
      "models": {
        "moonshot/kimi-k3": {
          "name": "KIMEY-k3"
        }
      }
    }
  },
  "shell": "powershell",
  "default_agent": "orchestrator",
  "subagent_depth": 2,
  "share": "manual",
  "plugin": [
    ["opencode-forking-agents-plugin", {
      "fork": { "default": true, "reviewDefault": false },
      "model": {
        "agents": {
          "explorer": "opencode/deepseek-v4-flash-free",
          "implementer": "opencode/deepseek-v4-flash-free",
          "tester": "opencode/deepseek-v4-flash-free",
          "reviewer": "merge/moonshot/kimi-k3",
          "web-researcher": "merge/moonshot/kimi-k3",
          "security-reviewer": "merge/moonshot/kimi-k3"
        }
      },
      "background": { "timeoutMs": 900000, "allowWriteCapable": false }
    }],
    "opencode-plugin-ast-lsp",
    "opencode-scout",
    "@tarquinen/opencode-dcp",
    "opencode-auto-resume",
    "@capybearista/opencode-adversarial-review",
    "opencode-rules",
    "@joshthomas/opencode-web-search",
    "opencode-websearch-cited@1.2.0",
    "./plugins/opencode-subagent-threads",
    "list"
  ],
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".git/**",
      ".cache/**",
      "coverage/**",
      "target/**"
    ]
  }
}
